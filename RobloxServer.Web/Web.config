<?xml version="1.0" encoding="utf-8"?>
<!--
  RobloxServer - ASP.NET 4.6 Web Forms (Visual Studio 2015 era).
  Runs on IIS 8.5+/IIS Express (Windows) or Mono xsp4 (Raspberry Pi / Linux).
  Every appSetting is optional; see Code/Config.cs for the defaults.
-->
<configuration>
  <appSettings>
    <add key="SiteName" value="ROBLOX" />
    <!-- URL the clients use. Empty = the address each request came in on (IP, http://robloxserver.lan/ from the
         Raspberry Pi DNS, or your DDNS name). Set it (e.g. http://robloxserver.lan/) to use one fixed address. -->
    <add key="BaseUrl" value="" />
    <!-- Base for api.roblox.com style endpoints. Empty = same as BaseUrl. -->
    <add key="ApiUrl" value="" />
    <!-- RCC style apiKey (GUID) required by /GetAllowedMD5Hashes/ and /GetAllowedSecurityVersions/. Empty = open. -->
    <add key="ApiKey" value="" />
    <add key="RegistrationOpen" value="true" />
    <!-- Comma separated admin user names. The first account ever registered is also an admin. -->
    <add key="Administrators" value="" />
    <!-- Anyone | Owner | Admin -->
    <add key="HostPolicy" value="Anyone" />
    <add key="RequireAuthTickets" value="true" />
    <add key="AuthTicketMinutes" value="5" />
    <!-- 2015 client verification lists, comma separated. -->
    <add key="AllowedSecurityVersions" value="0.235.0pcplayer" />
    <add key="AllowedMD5Hashes" value="" />
    <!-- Same limit the old express-rate-limit used: 45 requests every 30 seconds per IP. -->
    <add key="RateLimitRequests" value="45" />
    <add key="RateLimitWindowSeconds" value="30" />
    <add key="LoginFloodAttempts" value="5" />
    <add key="LoginFloodMinutes" value="5" />
    <!-- IP of the Raspberry Pi reverse proxy, so X-Forwarded-For is trusted. -->
    <add key="TrustedProxies" value="" />
    <!-- Public IP / DDNS name of the Raspberry Pi. Shown instead of LAN addresses to players outside the LAN. -->
    <add key="PublicGameAddress" value="" />
    <add key="MaxPlaceSizeMegabytes" value="50" />
    <add key="FirstLocalAssetId" value="1900000000" />
    <!-- Roblox | None: what /asset/?id= does with ids that are not stored here. -->
    <add key="AssetFallback" value="Roblox" />
    <!-- Clients games can be published for (2007-2013, year + E/M/L). Only 2012M and 2013M have join/host scripts. Remove the ones you do not install. -->
    <add key="Clients" value="2007E,2007M,2007L,2008E,2008M,2008L,2009E,2009M,2009L,2010E,2010M,2010L,2011E,2011M,2011L,2012E,2012M,2012L,2013E,2013M,2013L" />
    <add key="DefaultClient" value="2012M" />
    <!-- Where "Download ROBLOX" goes when App_Data/Launcher/RobloxPlayerLauncher.exe does not exist (empty: GitHub releases). -->
    <add key="LauncherDownloadUrl" value="" />
    <!-- Where /Install/Download.ashx?client=2012M|2013M goes when that zip is not in App_Data/Clients (empty: ROBLOX 2007-2013 on archive.org). -->
    <add key="ClientsArchiveUrl" value="" />
  </appSettings>

  <system.web>
    <!-- CHAVES CORRIGIDAS: Tamanho exato de 128 caracteres para validação e 64 para criptografia -->
    <machineKey validationKey="6864B9FB5E5431840F3E7B9CCCEAD4BFCC51D62D07EC3B5D4FB4876D561037EFAF976D5935C7C90118D547B0FF0DF4D892E6583F7EFFFDC65D4C85A9EFED0714"
            decryptionKey="CC8441E3DF5B9834C841FB829C22CE6AF74C7D4C943ABFA9772E1FEB02DC4CF4"
            validation="HMACSHA256"
            decryption="AES" />

    <compilation debug="false" targetFramework="4.6" />
    <httpRuntime targetFramework="4.6" maxRequestLength="102400" enableVersionHeader="true" />
    
    <authentication mode="Forms">
      <!-- Removido requireSSL/domain engessados para evitar rejeição do cookie pelo proxy da Vercel -->
      <forms name=".ROBLOSECURITY" loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="43200"
             slidingExpiration="true" cookieless="UseCookies" protection="All" path="/" />
    </authentication>
    <httpCookies httpOnlyCookies="true" />
    <sessionState mode="Off" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" enableEventValidation="true" validateRequest="true" viewStateEncryptionMode="Auto" />
    <customErrors mode="RemoteOnly" redirectMode="ResponseRewrite" defaultRedirect="~/Error.aspx">
      <error statusCode="404" redirect="~/NotFound.aspx" />
    </customErrors>
  </system.web>

  <!-- Client zips are big: only the Admin page accepts uploads up to 1 GB. -->
  <location path="Admin.aspx">
    <system.web>
      <httpRuntime targetFramework="4.6" maxRequestLength="1048576" executionTimeout="3600" enableVersionHeader="true" />
    </system.web>
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="1073741824" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <system.webServer>
    <!-- Global.asax must see every request (.php, .txt and extensionless 2015 URLs are rewritten to .ashx). -->
    <modules runAllManagedModulesForAllRequests="true" />
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
        <fileExtensions>
          <add fileExtension=".php" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
